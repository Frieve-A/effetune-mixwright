{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "EFFETUNE_BUILD_PLUGIN": "ON",
        "EFFETUNE_BUILD_TESTS": "ON",
        "EFFETUNE_BUILD_TOOLS": "ON",
        "EFFETUNE_AUTOMATION_HOST_GATE_FIXTURE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-automation-host-gate",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/windows-automation-host-gate",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EFFETUNE_AUTOMATION_HOST_GATE_FIXTURE": "ON"
      }
    },
    {
      "name": "mac-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "EFFETUNE_BUILD_PLUGIN": "ON",
        "EFFETUNE_BUILD_TESTS": "ON",
        "EFFETUNE_BUILD_TOOLS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "mac-debug",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mac-release",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    {
      "name": "windows-automation-host-gate",
      "configurePreset": "windows-automation-host-gate"
    },
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-release", "configurePreset": "mac-release" }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-automation-host-gate",
      "configurePreset": "windows-automation-host-gate",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "mac-debug",
      "configurePreset": "mac-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "mac-release",
      "configurePreset": "mac-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
